# Copy to env.sh and adjust for your machine.
#
# e2e.sh sources env.sh when it exists; without it the suite assumes php, dotnet
# and a Chrome binary are already on PATH. Each function only has to leave the
# named tool on PATH by the time it returns.
#
# Requirements:
#   php     8.1+ with the openssl and bcmath extensions
#   openssl 3.2+ command line, for Argon2id (php's own openssl extension may be older)
#   dotnet  SDK 10
#   chrome  80+ (headless), as google-chrome, chrome or google-chrome-stable
#
# Examples:
#   load_php() { export PATH=/opt/php-8.1/bin:$PATH; }
#   load_php() { module purge; module add php/8.1 openssl/3.5; }    # environment modules

load_php()    { :; }
load_dotnet() { :; }
load_chrome() { :; }
